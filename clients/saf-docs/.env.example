# Public PostHog project API key (safe to expose in the frontend).
# Loaded by Vite at build time — used by @saflib/vendors-posthog-client.
#
# For production / Docker builds, copy to `.env.production` (or set the same
# vars in the build environment):
#   VITE_POSTHOG_PROJECT_API_KEY=phc_...
#   VITE_POSTHOG_PROJECT_HOST=https://us.i.posthog.com
#
# For local `vitepress dev`, use `.env` or `.env.local` (gitignored).

VITE_POSTHOG_PROJECT_API_KEY=
# VITE_POSTHOG_PROJECT_HOST=https://us.i.posthog.com
