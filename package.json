{
  "name": "@saf-2025/saf-2025",
  "description": "Site and demonstration of SAF features.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "npm run test:coverage --workspaces --if-present --parallel",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "vue-tsc -b",
    "cleanup-declarations": "saf-imports tsconfig cleanup-declarations --root saflib",
    "format": "prettier --write .",
    "lock-prune": "saf-lock-prune"
  },
  "author": "Scott Erickson <sderickson@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "clients/*",
    "deploy/*",
    "saflib/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "better-sqlite3": "12.11.1",
    "@types/node": "^24.3.0"
  },
  "devDependencies": {
    "@saflib/monorepo": "*",
    "vitest": "*",
    "vue-tsc": "*"
  },
  "dependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/docker": "*",
    "@saflib/docs": "*",
    "@saflib/vue": "*"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
