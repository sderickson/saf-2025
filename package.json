{
  "name": "@saf-2025/saf-2025",
  "description": "Site and demonstration of SAF features.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "npm run test:coverage --workspaces --if-present --parallel",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "vue-tsc -b",
    "cleanup-declarations": "saf-imports tsconfig cleanup-declarations --root saflib",
    "format": "prettier --write .",
    "lock-prune": "saf-monorepo lock-prune"
  },
  "author": "Scott Erickson <sderickson@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "clients/*",
    "deploy/*",
    "saflib/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "better-sqlite3": "12.11.1",
    "@types/node": "^24.3.0",
    "vue-router": "^5.0.0",
    "vuetify": "^4.1.6",
    "vite": "8.0.13",
    "rolldown": "1.0.1",
    "vue": "3.5.20",
    "@vue/compiler-core": "3.5.20",
    "@vue/compiler-dom": "3.5.20",
    "@vue/compiler-sfc": "3.5.20",
    "@vue/compiler-ssr": "3.5.20",
    "@vue/reactivity": "3.5.20",
    "@vue/runtime-core": "3.5.20",
    "@vue/runtime-dom": "3.5.20",
    "@vue/server-renderer": "3.5.20",
    "@vue/shared": "3.5.20",
    "typescript": "~6.0.0",
    "msw": "2.12.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.11.0"
  },
  "devDependencies": {
    "@saflib/monorepo": "*",
    "vitest": "*",
    "vue-tsc": "*"
  },
  "dependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/docker": "*",
    "@saflib/docs": "*",
    "@saflib/vue": "*"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
