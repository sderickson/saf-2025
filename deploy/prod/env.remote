# Settings for `saf-deploy` (see @saflib/deploy-cli).

# The username and hostname for SSHing into the remote server.
SSH_HOSTNAME=root@saf-demo.online

# Where production images are pushed to, and pulled from.
CONTAINER_REGISTRY=ghcr.io/sderickson

# Where the remote-assets zip is uploaded, and where it's unpacked (compose
# runs there).
REMOTE_ZIP_PATH=/root
REMOTE_ASSETS_FOLDER_PATH=/root/saf-2025/deploy/prod/remote-assets

# SSH already logs in as root.
REMOTE_SUDO=0
